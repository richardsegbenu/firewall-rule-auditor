# Sample iptables-save output for the auditor.
# Save as iptables.rules and run:
#   python -m auditor.cli samples/iptables.rules --type iptables

*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -s 10.0.0.0/8 -p tcp --dport 22 -j ACCEPT
-A INPUT -p tcp --dport 80 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT
-A INPUT -p tcp --dport 3389 -j ACCEPT
-A INPUT -s 192.168.0.0/16 -p tcp --dport 5432 -j ACCEPT
-A FORWARD -p tcp -j ACCEPT
COMMIT
